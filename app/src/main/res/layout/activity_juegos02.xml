<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo002"
    android:padding="24dp"
    tools:context=".controller.Juegos02"> <!-- MEJORA: El contexto ahora apunta a Juego2 -->

    <!-- Puntaje en la esquina superior derecha -->
    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:padding="8dp"
        android:text="@string/score_label"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título del Juego -->
    <TextView
        android:id="@+id/tvGameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="@string/juego_titulo_animales"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvScore" />

    <!-- Palabra a Adivinar -->
    <TextView
        android:id="@+id/tvWordToGuess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/black"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGameTitle"
        tools:text="Hummingbird" /> <!-- Texto de previsualización -->

    <!-- GridLayout con las opciones -->
    <GridLayout
        android:id="@+id/gridLayoutOptions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toTopOf="@+id/textFeedback"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWordToGuess"
        app:layout_constraintVertical_bias="0.5">

        <!-- Los ImageButton son genéricos, se llenarán desde el código -->
        <ImageButton
            android:id="@+id/imgOption1"
            style="@style/GameImageButton"
            android:contentDescription="@string/opcion_de_juego_1"
            tools:src="@drawable/colibri" />

        <ImageButton
            android:id="@+id/imgOption2"
            style="@style/GameImageButton"
            android:contentDescription="@string/opcion_de_juego_2"
            tools:src="@drawable/unicor" />

        <ImageButton
            android:id="@+id/imgOption3"
            style="@style/GameImageButton"
            android:contentDescription="@string/opcion_de_juego_3"
            tools:src="@drawable/mariposa" />

        <ImageButton
            android:id="@+id/imgOption4"
            style="@style/GameImageButton"
            android:contentDescription="@string/opcion_de_juego_4"
            tools:src="@drawable/fondopatolucas" /> <!-- Añadí un 4to animal para el ejemplo -->
    </GridLayout>

    <!-- Mensaje de Feedback (Correcto/Incorrecto) -->
    <TextView
        android:id="@+id/textFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="¡Correcto!" />

</androidx.constraintlayout.widget.ConstraintLayout>
