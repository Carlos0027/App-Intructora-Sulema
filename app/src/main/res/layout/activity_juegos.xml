<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo001"
    android:padding="24dp"
    tools:context=".controller.Juegos"> <!-- Asegúrate de cambiar esto para Juego2, Juego3, etc. -->

    <!-- Puntaje en la esquina superior derecha (Esto está perfecto) -->
    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:padding="8dp"
        android:text="@string/score_label"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título del Juego -->
    <!-- MEJORA: Anclado a los lados para un centrado perfecto y debajo del puntaje para evitar solapamiento -->
    <TextView
        android:id="@+id/tvGameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="@string/juego_titulo_frutas"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvScore" />

    <!-- Palabra a Adivinar -->
    <!-- MEJORA: Anclado a los lados para un centrado perfecto. -->
    <TextView
        android:id="@+id/tvWordToGuess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/black"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGameTitle"
        tools:text="Watermelon" />

    <!-- GridLayout con las opciones -->
    <!-- MEJORA: Centrado verticalmente en el espacio restante para un mejor equilibrio visual. -->
    <GridLayout
        android:id="@+id/gridLayoutOptions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toTopOf="@+id/textFeedback"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWordToGuess"
        app:layout_constraintVertical_bias="0.5"> <!-- Centra el grid verticalmente -->

        <!-- Los ImageButtons son genéricos, se llenarán desde el código -->
        <ImageButton
            android:id="@+id/imgOption1"
            style="@style/GameImageButton"
            android:contentDescription="@string/opcion_de_juego_1"
            tools:src="@drawable/sandia" />

        <ImageButton
            android:id="@+id/imgOption2"
            style="@style/GameImageButton"
            android:contentDescription="@string/opcion_de_juego_2"
            tools:src="@drawable/mango" />

        <ImageButton
            android:id="@+id/imgOption3"
            style="@style/GameImageButton"
            android:contentDescription="@string/opcion_de_juego_3"
            tools:src="@drawable/manzana" />

        <ImageButton
            android:id="@+id/imgOption4"
            style="@style/GameImageButton"

            android:contentDescription="@string/opcion_de_juego_4"
            tools:src="@drawable/limmon" />
    </GridLayout>

    <!-- Mensaje de Feedback (Correcto/Incorrecto) -->
    <!-- MEJORA: Anclado a los lados para centrarse correctamente. -->
    <TextView
        android:id="@+id/textFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="¡Correcto!" />

</androidx.constraintlayout.widget.ConstraintLayout>
